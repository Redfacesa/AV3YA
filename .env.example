# RedFace Pay shared Supabase (same project as Redface-pay)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AV3YA merchant — optional; auto-loaded from DB after migration 0396
# NEXT_PUBLIC_AV3YA_MERCHANT_ID=

# RedFace Pay checkout origin
NEXT_PUBLIC_REDFACE_PAY_URL=https://www.redfacepay.co.za

# Ecosystem commerce edge function
NEXT_PUBLIC_REDFACE_COMMERCE_API=https://bpzzgilwlkghgfkvkkxx.supabase.co/functions/v1/ecosystem-commerce

# Optional ecosystem API key (matches ECOSYSTEM_API_KEY secret in Supabase)
ECOSYSTEM_API_KEY=

# Site URL (Vercel production)
NEXT_PUBLIC_SITE_URL=https://av3ya.vercel.app

# OpenRouter — AI virtual try-on (image models only, server-side)
OPENROUTER_API_KEY=
