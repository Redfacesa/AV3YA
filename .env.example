# RedFace Pay shared Supabase (same project as Redface-pay)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AV3YA merchant — set on Vercel only (or copy from get_ecosystem_app_config)
NEXT_PUBLIC_AV3YA_MERCHANT_ID=

# RedFace Pay checkout origin
NEXT_PUBLIC_REDFACE_PAY_URL=https://www.redfacepay.co.za

# Ecosystem commerce edge function (Supabase project URL + /functions/v1/ecosystem-commerce)
NEXT_PUBLIC_REDFACE_COMMERCE_API=

# Site URL (Vercel production or custom domain)
NEXT_PUBLIC_SITE_URL=https://av3ya.vercel.app

# Optional ecosystem API key
# ECOSYSTEM_API_KEY=

# Optional — AI virtual try-on (server-side only)
OPENROUTER_API_KEY=
