# ── AV3YA · Vercel env template (safe to commit — no secrets) ────────────────
# 1. Copy to vercel.env.local (gitignored)
# 2. Fill in values from RedFace Pay / Supabase dashboards
# 3. Paste into Vercel → Settings → Environment Variables (never commit real keys)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_AV3YA_MERCHANT_ID=
NEXT_PUBLIC_REDFACE_PAY_URL=https://www.redfacepay.co.za
NEXT_PUBLIC_REDFACE_COMMERCE_API=
NEXT_PUBLIC_SITE_URL=https://av3ya.vercel.app

# Optional — AI try-on / assistant
OPENROUTER_API_KEY=

# Optional — only if commerce API returns 401
# ECOSYSTEM_API_KEY=
